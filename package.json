{
  "name": "devtools-br",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev:rest": "tsx src/rest/index.ts",
    "dev:mcp:stdio": "tsx src/mcp/stdio.ts",
    "dev:mcp:http": "tsx src/mcp/http.ts",
    "start:rest": "node dist/src/rest/index.js",
    "start:mcp:stdio": "node dist/src/mcp/stdio.js",
    "start:mcp:http": "node dist/src/mcp/http.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain",
    "test:rest": "vitest run tests/rest",
    "test:mcp": "vitest run tests/mcp",
    "test:oracle": "playwright test tests/oracle --pass-with-no-tests"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.4.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
